---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Disclaimer from '../components/Disclaimer.astro';
import JsonLd from '../components/JsonLd.astro';
import Base from '../layouts/Base.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE, url } from '../lib/site';

const path = '/about/';
const trail = [
  { name: 'Головна', href: '/' },
  { name: 'Про нас', href: path },
];
const abs = (p: string) => new URL(url(p), Astro.site).href;
---

<Base
  title="Про нас — виробник приладів BMS у Києві | BMS Pro"
  description="Прилади біомеханічної стимуляції BMS виготовляються у Києві. Декларація UA.TR.D.00159-25, ТУ У 27.9-2294811615-001:2025."
  canonicalPath={path}
>
  <Fragment slot="head">
    <JsonLd data={breadcrumbSchema(trail.map((c) => ({ name: c.name, url: abs(c.href) })))} />
  </Fragment>

  <div class="wrap"><Breadcrumbs trail={trail} /></div>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Виробник</p>
        <h1>Власне виробництво в Києві</h1>
        <p>
          Прилади BMS для біомеханічної стимуляції ми виготовляємо у Києві — повний цикл:
          виробництво, складання й обслуговування.
        </p>
      </div>

      <div class="facts">
        <h2>Реєстраційні дані</h2>
        <dl>
          <dt>Виробник</dt><dd>{SITE.legalName}</dd>
          <dt>Декларація відповідності</dt><dd>{SITE.declaration}</dd>
          <dt>Дата реєстрації</dt><dd>{SITE.declarationDateDisplay}</dd>
          <dt>Технічні умови</dt><dd>{SITE.tu}</dd>
          <dt>Код ДКПП</dt><dd>27.90.1</dd>
          <dt>Адреса</dt>
          <dd>{SITE.address.postalCode}, м. {SITE.address.city}, {SITE.address.street}</dd>
        </dl>
        <p class="more">
          Повний текст паспорта, декларації та технічних умов —
          <a href={url('/documents/')}>у розділі «Технічна документація»</a>.
        </p>
      </div>

      <div class="cta-row">
        <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>☎ {SITE.phonePrimaryDisplay}</a>
        <a class="btn btn-2" href={url('/products/')}>Переглянути прилади</a>
      </div>

      <Disclaimer />
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
  }
  .facts {
    max-width: 700px;
  }
  .facts h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    margin-bottom: 1.2rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem 1.6rem;
    font-size: 0.92rem;
    padding: 1.2rem;
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: var(--r);
  }
  @media (max-width: 560px) {
    dl {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    dd {
      margin-bottom: 0.7rem;
    }
  }
  dt {
    font-family: var(--m);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel-2);
    padding-top: 0.25rem;
  }
  dd {
    margin: 0;
  }
  .more {
    margin-top: 1rem;
    font-size: 0.88rem;
    color: var(--body-soft);
  }
  .more a {
    color: var(--led);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  section :global(.warn) {
    margin-top: clamp(2rem, 5vw, 3rem);
    margin-inline: 0;
  }
</style>
