---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompareLink from '../../components/CompareLink.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Gallery from '../../components/Gallery.astro';
import JsonLd from '../../components/JsonLd.astro';
import SpecTiles from '../../components/SpecTiles.astro';
import Base from '../../layouts/Base.astro';
import { PRICE_NOTE, formatPrice } from '../../lib/format';
import { frequencyLabel, instrumentFor } from '../../lib/instrument';
import { breadcrumbSchema, productSchema } from '../../lib/schema';
import { SITE, url } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const d = product.data;

const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((p) => p.id !== product.id);
const panel = instrumentFor(d.indicator);
const gallery = d.gallery.length > 0 ? d.gallery : [d.image];

const path = `/products/${product.id}/`;
const abs = new URL(url(path), Astro.site).href;
const absImage = new URL(url(d.image), Astro.site).href;

const faqAll = await getCollection('faq');
const faq = faqAll
  .filter((q) => q.data.models.includes(product.id))
  .sort((a, b) => a.data.order - b.data.order);

const trail = [
  { name: 'Головна', href: '/' },
  { name: 'Прилади', href: '/products/' },
  { name: d.name, href: path },
];
const crumbSchema = breadcrumbSchema(
  trail.map((c) => ({ name: c.name, url: new URL(url(c.href), Astro.site).href })),
);

const { Content } = await render(product);
---

<Base
  title={`${d.name} — прилад біомеханічної стимуляції | BMS Pro`}
  description={`${d.tagline}. Орієнтовна ціна ${formatPrice(d.price)}. Виробництво у Києві.`}
  canonicalPath={path}
  ogImage={`/og/${product.id}.png`}
>
  <Fragment slot="head">
    <JsonLd data={productSchema(d, abs, absImage)} />
    <JsonLd data={crumbSchema} />
  </Fragment>

  <div class="wrap"><Breadcrumbs trail={trail} /></div>

  <div class="hero">
    <div class="wrap hero-grid">
      <Gallery images={gallery} name={d.name} />

      <div>
        <p class="eyebrow">{d.zones.join(' · ')}</p>
        <h1>{d.name}</h1>
        <p class="tagline">{d.tagline}</p>

        <p class="price">
          <b>{formatPrice(d.price)}</b><span>{PRICE_NOTE}</span>
        </p>

        <ul class="chips">
          <li>{d.channels === '1' || d.channels === '2' ? `${d.channels} канал` : d.channels}</li>
          <li>{panel.label}</li>
          <li>{frequencyLabel(d.specs)}</li>
          <li>II клас</li>
        </ul>

        <div class="cta-row">
          <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>
            ☎ Замовити — {SITE.phonePrimaryDisplay}
          </a>
        </div>

        <p class="trust">
          Гарантія 12 міс · Декларація {SITE.declaration} · Виробництво {SITE.address.city}
        </p>
      </div>
    </div>
  </div>

  <section class="about">
    <div class="wrap about-grid">
      <div class="sec-head">
        <p class="eyebrow">Опис</p>
        <h2>Що таке {d.name}</h2>
      </div>
      <div class="prose"><Content /></div>
    </div>
  </section>

  {
    d.benefits.length > 0 && (
      <section class="alt">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Чому саме цей прилад</p>
            <h2>Переваги {d.name}</h2>
          </div>
          <ul class="benefits">
            {d.benefits.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Характеристики</p>
        <h2>Технічні дані</h2>
      </div>
      <SpecTiles specs={d.specs} />

      {
        d.included.length > 0 && (
          <div class="included">
            <p class="sub">Комплектація</p>
            <ul>
              {d.included.map((it) => (
                <li>
                  <span>{it.item}</span>
                  <b>{it.qty} шт</b>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    faq.length > 0 && (
      <section>
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Питання та відповіді</p>
            <h2>Про {d.name}</h2>
          </div>
          <div class="faq">
            {faq.map((q) => (
              <details>
                <summary>{q.data.question}</summary>
                <div class="answer">{q.body}</div>
              </details>
            ))}
          </div>
          <p class="faq-more">
            <a href={url('/faq/')}>Усі питання про прилади BMS</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Модельний ряд</p>
        <h2>{d.name} — не єдина модель</h2>
        <p>
          У ряду пʼять приладів. Вони відрізняються зоною впливу, кількістю каналів, частотним
          діапазоном і потужністю.
        </p>
      </div>
      <ul class="siblings">
        {
          others.map((o) => (
            <li>
              <a href={url(`/products/${o.id}/`)}>
                <b>{o.data.name}</b>
                <span>{o.data.zones.join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <CompareLink note="Ціна, зона впливу, канали, частота та потужність усіх пʼяти приладів в одній таблиці" />
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <p class="eyebrow eyebrow-center">Замовлення</p>
      <h2>Замовити {d.name}</h2>
      <p class="final-lede">
        Зателефонуйте — підтвердимо наявність, вартість і терміни виготовлення.
      </p>
      <div class="cta-row cta-center">
        <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>☎ {SITE.phonePrimaryDisplay}</a>
        <a class="btn btn-2" href={`tel:${SITE.phoneSecondary}`}>{SITE.phoneSecondaryDisplay}</a>
      </div>
      <Disclaimer />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(2rem, 4vw, 3rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
  }
  .tagline {
    margin-top: 0.9rem;
    color: var(--body-soft);
    max-width: 46ch;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }
  .price b {
    font-family: var(--m);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--led);
  }
  .price span {
    font-size: 0.76rem;
    color: var(--steel-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .chips li {
    font-family: var(--m);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    border: 1px solid var(--rule);
    border-radius: 99px;
    padding: 0.35rem 0.75rem;
  }
  .trust {
    margin-top: 1.1rem;
    font-size: 0.78rem;
    color: var(--steel-2);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
  }
  .benefits li {
    display: flex;
    gap: 0.8rem;
    padding: 1.05rem 1.2rem;
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: 9px;
    font-size: 0.94rem;
    color: var(--body-soft);
  }
  .benefits li::before {
    content: '';
    flex: none;
    width: 14px;
    height: 1px;
    margin-top: 0.72em;
    background: var(--led);
  }

  .about {
    border-top: 1px solid var(--rule);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.4rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 880px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-grid .sec-head {
    margin-bottom: 0;
  }
  .prose {
    max-width: 62ch;
    color: var(--body-soft);
  }
  /* markdown children — the global reset zeroes every margin */
  .prose :global(p + p) {
    margin-top: 1rem;
  }
  .prose :global(h3) {
    margin-top: 1.9rem;
    font-size: 1.18rem;
    color: var(--paper);
  }
  .prose :global(h3 + p) {
    margin-top: 0.6rem;
  }

  .siblings {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.7rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 860px) {
    .siblings {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .siblings {
      grid-template-columns: 1fr;
    }
  }
  .siblings a {
    display: block;
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: var(--panel-2);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .siblings a:hover {
    border-color: var(--led);
    background: var(--panel-3);
  }
  .siblings b {
    display: block;
    font-family: var(--d);
    font-weight: 500;
    font-size: 1.02rem;
  }
  .siblings span {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--m);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-2);
  }
  .alt {
    background: #0b1114;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .sub {
    font-family: var(--d);
    font-weight: 500;
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .included {
    margin-top: clamp(1.6rem, 3.5vw, 2.4rem);
    max-width: 460px;
  }
  .included ul {
    border: 1px solid var(--rule);
    border-radius: 9px;
    overflow: hidden;
  }
  .included li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    background: var(--panel-2);
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
  }
  .included li:last-child {
    border-bottom: 0;
  }
  .included b {
    font-family: var(--m);
    font-weight: 500;
    color: var(--steel);
  }

  .faq-more {
    margin-top: 1.2rem;
    font-size: 0.9rem;
  }
  .faq-more a {
    color: var(--led);
  }
  .faq details {
    border-bottom: 1px solid var(--rule);
  }
  .faq summary {
    cursor: pointer;
    padding: 1.1rem 0;
    font-family: var(--d);
    font-weight: 500;
    font-size: 1.08rem;
  }
  .faq summary:hover {
    color: var(--led);
  }
  .faq .answer {
    padding-bottom: 1.2rem;
    color: var(--body-soft);
    font-size: 0.92rem;
    max-width: 62ch;
  }

  .final {
    text-align: center;
  }
  .final h2 {
    margin: 0.9rem auto 0;
    max-width: 24ch;
  }
  .final-lede {
    margin: 1rem auto 0;
    max-width: 48ch;
    color: var(--body-soft);
  }
  .final :global(.warn) {
    margin-top: clamp(2rem, 5vw, 3rem);
  }
</style>
