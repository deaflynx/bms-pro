---
import { getCollection } from 'astro:content';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import Diagram from '../components/Diagram.astro';
import Disclaimer from '../components/Disclaimer.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import SpecTiles from '../components/SpecTiles.astro';
import VideoFacade from '../components/VideoFacade.astro';
import Base from '../layouts/Base.astro';
import { itemListSchema, websiteSchema } from '../lib/schema';
import { SITE, url } from '../lib/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const bmsM = products.find((p) => p.id === 'bms-m')!;

const siteUrl = new URL(url('/'), Astro.site).href;
const listItems = products.map((p) => ({
  name: p.data.name,
  url: new URL(url(`/products/${p.id}/`), Astro.site).href,
}));

// Hero showcase: one tab per model, each opening a slider of detail shots.
const HERO_TAGS: Record<string, string> = {
  'bms-m': 'Дім · обличчя, шия',
  'bms-pro': 'Дім, салон · шия, спина',
  'bms-nexus': 'Салон, кабінет · два канали',
  'bms-quadro': 'Кабінет · роликовий вузол',
};
const HERO = products.map((p) => ({
  id: p.id,
  name: p.data.name,
  tag: HERO_TAGS[p.id] ?? p.data.usage,
  href: url(`/products/${p.id}/`),
  images: p.data.gallery,
}));

const TICKER = [
  { value: '20–40 Гц', label: 'Частота коливань насадки' },
  { value: '≤20 Вт', label: 'Споживана потужність' },
  { value: 'II клас', label: 'Електробезпека' },
  { value: '45 / 15 хв', label: 'Робота / пауза' },
  { value: '12 міс', label: 'Гарантія виробника' },
];

const EFFECTS = [
  {
    kind: 'circulation' as const,
    title: 'Посилення кровообігу',
    text: 'Вібрація діє як «периферичне серце», стимулюючи рух крові та лімфи в опрацьованій зоні.',
  },
  {
    kind: 'metabolic' as const,
    title: 'Метаболічна активація',
    text: 'Механічні хвилі прискорюють обмін речовин у тканинах і виведення продуктів розпаду.',
  },
  {
    kind: 'neuromuscular' as const,
    title: 'Нейромʼязовий відгук',
    text: 'Стимуляція покращує звʼязок «мозок — мʼяз», що сприяє координації та тонусу.',
  },
];

const AREAS = [
  {
    icon: 'face' as const,
    title: 'Косметологія та омолодження',
    text: 'БМС обличчя (наприклад, за методикою Назарова) використовується для підтяжки шкіри, зменшення зморшок та зняття набряклості.',
  },
  {
    icon: 'sport' as const,
    title: 'Спорт та фітнес',
    text: 'Використовується для швидкого відновлення після навантажень, збільшення мʼязової сили та гнучкості.',
  },
  {
    icon: 'rehab' as const,
    title: 'Відновлення рухливості',
    text: 'Застосовується при мʼязовій слабкості, для покращення рухливості суглобів і зняття мʼязової напруги.',
  },
];

const AUDIENCE = [
  { icon: 'desk' as const, text: 'Людям із сидячою або статичною роботою' },
  { icon: 'load' as const, text: 'Користувачам із регулярними фізичними навантаженнями' },
  { icon: 'home' as const, text: 'Тим, хто шукає простий спосіб механічної стимуляції мʼязів удома' },
  { icon: 'senior' as const, text: 'Людям старшого віку — за умови дотримання інструкції з експлуатації' },
  { icon: 'wave' as const, text: 'Для загального мʼязового комфорту' },
  { icon: 'daily' as const, text: 'Як елемент щоденного догляду за тілом' },
];

const DOCS = [
  { label: 'Паспорт приладу', note: 'Технічні дані та комплектація', href: '/documents/bms-m/passport/' },
  { label: 'Декларація відповідності', note: SITE.declaration, href: '/documents/bms-m/declaration/' },
  { label: 'Технічні умови', note: SITE.tu, href: '/documents/bms-m/technical-conditions/' },
];
---

<Base
  title="BMS Pro — прилади біомеханічної стимуляції мʼязів"
  description="Прилади BMS для механічної стимуляції мʼязів у діапазоні 20–40 Гц: BMS m, pro, Nexus, Quadro. Власне виробництво, Київ."
  canonicalPath="/"
>
  <Fragment slot="head">
    <JsonLd data={websiteSchema(siteUrl)} />
    <JsonLd data={itemListSchema(listItems)} />
  </Fragment>

  <div class="hero">
    <img
      class="hero-bg"
      src={url('/assets/img/case-backdrop.webp')}
      alt=""
      width="900"
      height="675"
    />
    <span class="hero-scrim"></span>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Біомеханічна стимуляція · Київ</p>
        <h1>Механічна стимуляція мʼязів на частоті <em>20–40 Гц</em></h1>
        <p class="lede">
          Прилади BMS передають вібрацію вздовж мʼязового волокна. Частоту ви обираєте самі —
          регулятором на панелі приладу.
        </p>
        <div class="cta-row">
          <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>Зателефонувати</a>
          <a class="btn btn-2" href="#compare">Порівняти прилади</a>
        </div>
      </div>
      <HeroShowcase models={HERO} />
    </div>
  </div>

  <div class="ticker">
    <div class="wrap">
      <ul>
        {TICKER.map((t) => <li><b>{t.value}</b><span>{t.label}</span></li>)}
      </ul>
    </div>
  </div>

  <section id="what">
    <div class="wrap what-grid">
      <div class="sec-head">
        <p class="eyebrow">Метод</p>
        <h2>Що таке біомеханічна стимуляція</h2>
      </div>
      <div class="what-text">
        <p>
          Стимуляція. Біостимуляція. Біомеханічна стимуляція. Перші два терміни вам,
          найімовірніше, знайомі — третій пояснюємо нижче.
        </p>
        <p class="def">
          <b>Біомеханічна стимуляція</b> — це метод механічного впливу на мʼязи за допомогою
          вібрацій певної частоти та амплітуди, спрямованих уздовж мʼязових волокон. На відміну
          від звичайного масажу, прилади BMS імітують природну роботу мʼязів під час фізичних
          навантажень, що дозволяє активувати глибокі процеси в організмі без виснажливих
          тренувань.
        </p>
        <a class="more" href={url('/how-it-works/')}>Як це працює докладніше →</a>
      </div>
    </div>
  </section>

  <section id="compare" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Модельний ряд · 4 прилади</p>
        <h2>Який прилад вам потрібен</h2>
        <p>
          Моделі відрізняються зоною впливу та кількістю каналів — від однієї насадки для
          обличчя до роликового вузла для спини.
        </p>
      </div>
      <ComparisonMatrix products={products} />
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Принцип дії</p>
        <h2>Що робить вібрація з мʼязом</h2>
        <p>
          Керовані коливання вздовж мʼязового волокна дають три помітні ефекти — від руху
          крові та лімфи до відгуку нервової системи.
        </p>
      </div>
      <div class="how-grid">
        {
          EFFECTS.map((e) => (
            <div class="how">
              <Diagram kind={e.kind} />
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))
        }
      </div>
      <VideoFacade
        id="VV3J9_Tyth4"
        caption="Відео: біомеханічна стимуляція мʼязів — принцип роботи приладу. Тимчасове відео для макета, буде замінено на власне."
      />
    </div>
  </section>

  <section id="for-whom" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Для кого</p>
        <h2>Основні сфери застосування</h2>
        <p>
          Один і той самий принцип працює на обличчі, у спорті та у відновленні рухливості —
          відрізняються насадка, зона й тривалість сеансу.
        </p>
      </div>

      <div class="areas">
        {
          AREAS.map((a) => (
            <article class="area">
              <Icon kind={a.icon} />
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </article>
          ))
        }
      </div>

      <p class="sub">Кому може бути корисним</p>
      <ul class="audience">
        {
          AUDIENCE.map((a) => (
            <li>
              <Icon kind={a.icon} />
              <span>{a.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="specs" class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Характеристики та документи</p>
        <h2>Технічні дані й документація</h2>
        <p>
          В основі приладів — електромеханічний вузол із двигуном постійного струму на 12 В,
          який створює керовані механічні коливання.
        </p>
      </div>
      <SpecTiles
        specs={bmsM.data.specs}
        note="Характеристики наведено для приладу BMS m згідно з паспортом. Дані для інших моделей — у відповідних паспортах."
      />
      <div class="tech-cols">
        <div>
          <p class="sub">Технічна документація</p>
          <div class="doc-list">
            {
              DOCS.map((d) => (
                <a class="doc" href={url(d.href)}>
                  <span class="pdf">PDF</span>
                  <b>{d.label}</b>
                  <span class="note">{d.note}</span>
                </a>
              ))
            }
          </div>
        </div>
        <div>
          <p class="sub">Виробник</p>
          <dl class="reg">
            <dt>Виробник</dt><dd>{SITE.legalName}</dd>
            <dt>Декларація</dt><dd>{SITE.declaration}</dd>
            <dt>Зареєстровано</dt><dd>{SITE.declarationDateDisplay}</dd>
            <dt>Адреса</dt>
            <dd>{SITE.address.postalCode}, {SITE.address.city}, {SITE.address.street}</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <p class="eyebrow eyebrow-center">Замовлення</p>
      <h2>Підберемо прилад під ваше завдання</h2>
      <p class="final-lede">
        Зателефонуйте — розкажемо, чим відрізняються моделі, та узгодимо доставку.
      </p>
      <div class="cta-row cta-center">
        <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>☎ {SITE.phonePrimaryDisplay}</a>
        <a class="btn btn-2" href={`tel:${SITE.phoneSecondary}`}>{SITE.phoneSecondaryDisplay}</a>
      </div>
      <Disclaimer />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* the open case, dimmed to a backdrop the headline can sit on */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.62) saturate(0.6);
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(
        96deg,
        rgba(14, 20, 23, 0.94) 18%,
        rgba(14, 20, 23, 0.6) 55%,
        rgba(14, 20, 23, 0.3) 100%
      ),
      linear-gradient(rgba(14, 20, 23, 0.4), rgba(14, 20, 23, 0.05) 45%, rgba(14, 20, 23, 0.65));
  }
  @media (max-width: 940px) {
    .hero-scrim {
      background:
        linear-gradient(rgba(14, 20, 23, 0.92) 45%, rgba(14, 20, 23, 0.7)),
        linear-gradient(96deg, rgba(14, 20, 23, 0.8), rgba(14, 20, 23, 0.5));
    }
  }
  /* faint oscilloscope grid, ties the page to the instrument */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 20% 40%, #000, transparent 70%);
  }
  .hero-inner {
    display: block;
  }
  .hero-copy {
    max-width: 640px;
    margin-bottom: clamp(1.8rem, 4vw, 2.6rem);
  }
  .hero h1 {
    margin-top: 1.3rem;
  }
  /* the showcase spans the full width beneath the copy */
  .hero-inner :global(.showcase) {
    position: relative;
  }

  .ticker {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--rule);
  }
  .ticker ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 1px;
  }
  .ticker li {
    background: var(--panel-2);
    padding: 1.1rem clamp(0.9rem, 3vw, 2rem);
  }
  .ticker b {
    display: block;
    font-family: var(--m);
    font-size: 1.18rem;
    font-weight: 700;
  }
  .ticker span {
    font-size: 0.76rem;
    color: var(--steel);
    letter-spacing: 0.04em;
  }

  .alt {
    background: #0b1114;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .what-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.4rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 820px) {
    .what-grid {
      grid-template-columns: 1fr;
    }
  }
  .what-grid .sec-head {
    margin-bottom: 0;
  }
  .what-text p {
    color: var(--body-soft);
    max-width: 62ch;
  }
  .what-text .def {
    margin-top: 1.1rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--led);
    color: var(--paper);
  }
  .what-text .def b {
    font-weight: 500;
    color: #fff;
  }
  .more {
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.4rem 0;
    font-family: var(--m);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--led);
  }
  .more:hover {
    text-decoration: underline;
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 820px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
  .how {
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    padding: 1.3rem 1.4rem 1.5rem;
  }
  .how h3 {
    font-size: 1.14rem;
  }
  .how p {
    font-size: 0.88rem;
    color: var(--body-mute);
    margin-top: 0.45rem;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 820px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .area {
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    padding: 1.4rem 1.4rem 1.6rem;
    --icon-size: 36px;
  }
  .area h3 {
    margin-top: 1rem;
    font-size: 1.1rem;
  }
  .area p {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--body-mute);
  }
  .audience {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }
  @media (max-width: 980px) {
    .audience {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .audience {
      grid-template-columns: 1fr;
    }
  }
  .audience li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: rgba(21, 30, 35, 0.55);
    font-size: 0.9rem;
    color: var(--body-soft);
    --icon-size: 26px;
  }
  #for-whom .sub {
    margin: clamp(2rem, 4vw, 2.8rem) 0 1rem;
  }

  .tech-cols {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    margin-top: clamp(1.6rem, 3.5vw, 2.4rem);
  }
  @media (max-width: 820px) {
    .tech-cols {
      grid-template-columns: 1fr;
    }
  }
  .sub {
    font-family: var(--d);
    font-weight: 500;
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .doc-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .doc {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: var(--panel-2);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .doc:hover {
    border-color: var(--led);
    background: var(--panel-3);
  }
  .doc .pdf {
    font-family: var(--m);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--amber);
    border: 1px solid rgba(240, 169, 59, 0.45);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    flex: none;
  }
  .doc b {
    font-weight: 500;
    font-size: 0.93rem;
    flex: 1;
  }
  .doc .note {
    font-family: var(--m);
    font-size: 0.72rem;
    color: var(--steel-2);
    text-align: right;
  }
  .reg {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.4rem;
    font-size: 0.9rem;
    padding: 1.2rem;
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: 9px;
  }
  .reg dt {
    font-family: var(--m);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel-2);
    padding-top: 0.25rem;
  }
  .reg dd {
    margin: 0;
  }

  .final {
    text-align: center;
  }
  .final h2 {
    margin: 0.9rem auto 0;
    max-width: 22ch;
  }
  .final-lede {
    margin: 1rem auto 0;
    max-width: 48ch;
    color: var(--body-soft);
  }
  .final :global(.warn) {
    margin-top: clamp(2rem, 5vw, 3rem);
  }
</style>
