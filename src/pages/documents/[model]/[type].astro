---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import JsonLd from '../../../components/JsonLd.astro';
import Base from '../../../layouts/Base.astro';
import DocumentPage from '../../../layouts/DocumentPage.astro';
import { breadcrumbSchema, documentSchema } from '../../../lib/schema';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const docs = await getCollection('documents');
  const products = await getCollection('products');
  return docs.map((doc) => ({
    params: { model: doc.data.model, type: doc.data.type },
    props: { doc, product: products.find((p) => p.id === doc.data.model)! },
  }));
}

interface Props {
  doc: CollectionEntry<'documents'>;
  product: CollectionEntry<'products'>;
}
const { doc, product } = Astro.props;
const d = doc.data;

const path = `/documents/${d.model}/${d.type}/`;
const abs = (p: string) => new URL(url(p), Astro.site).href;

const trail = [
  { name: 'Головна', href: '/' },
  { name: 'Технічна документація', href: '/documents/' },
  { name: product.data.name, href: `/products/${product.id}/` },
  { name: d.title, href: path },
];

const { Content, headings } = await render(doc);
---

<Base
  title={`${d.title} — ${d.designation} | BMS Pro`}
  description={`${d.lead}. Повний текст документа та PDF для завантаження. Виробництво у Києві.`}
  canonicalPath={path}
>
  <Fragment slot="head">
    <JsonLd data={documentSchema({ title: d.title, designation: d.designation }, abs(path))} />
    <JsonLd data={breadcrumbSchema(trail.map((c) => ({ name: c.name, url: abs(c.href) })))} />
  </Fragment>

  <DocumentPage
    title={d.title}
    lead={d.lead}
    designation={d.designation}
    pdf={d.pdf}
    image={d.image}
    headings={headings}
    trail={trail}
  >
    <Content />
  </DocumentPage>
</Base>
