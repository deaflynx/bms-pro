---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import JsonLd from '../../components/JsonLd.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE, url } from '../../lib/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const productName = (id: string) => products.find((p) => p.id === id)?.data.name ?? id;
const productRank = (id: string) => products.findIndex((p) => p.id === id);

const TYPE_ORDER = ['passport', 'declaration', 'technical-conditions'];

// One entry per document, hosted under its first model; the others are named alongside.
const docs = (await getCollection('documents'))
  .map((doc) => ({
    href: `/documents/${doc.data.models[0]}/${doc.data.type}/`,
    title: `${doc.data.title} ${productName(doc.data.models[0])}`,
    alsoFor: doc.data.models.slice(1).map(productName),
    designation: doc.data.designation,
    hasPdf: Boolean(doc.data.pdf),
    rank: productRank(doc.data.models[0]) * 10 + TYPE_ORDER.indexOf(doc.data.type),
  }))
  .sort((a, b) => a.rank - b.rank);

const trail = [
  { name: 'Головна', href: '/' },
  { name: 'Технічна документація', href: '/documents/' },
];
const abs = (p: string) => new URL(url(p), Astro.site).href;
---

<Base
  title="Технічна документація BMS — паспорт, декларація, ТУ"
  description="Паспорт, декларація відповідності UA.TR.D.00159-25 і технічні умови ТУ У 27.9-2294811615-001:2025 для BMS m і BMS pro, паспорт BMS Quadro. Повний текст і PDF."
  canonicalPath="/documents/"
>
  <Fragment slot="head">
    <JsonLd data={breadcrumbSchema(trail.map((c) => ({ name: c.name, url: abs(c.href) })))} />
  </Fragment>

  <div class="wrap"><Breadcrumbs trail={trail} /></div>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Технічна документація</p>
        <h1>Документація на прилади BMS</h1>
        <p>
          Повний текст кожного документа опублікований на сайті окремою сторінкою; де є PDF, його
          можна завантажити. Декларацію зареєстровано на {SITE.legalName}, номер
          {SITE.declaration}, дата реєстрації {SITE.declarationDateDisplay}.
        </p>
      </div>

      <ul class="doc-list">
        {
          docs.map((d) => (
            <li>
              <a class="doc" href={url(d.href)}>
                <span class="doc-text">
                  <b>{d.title}</b>
                  {d.alsoFor.length > 0 && (
                    <span class="also">Стосується також {d.alsoFor.join(', ')}</span>
                  )}
                  <span class="desig">{d.designation}</span>
                </span>
                {d.hasPdf && <span class="pdf">PDF</span>}
                <span class="open">Відкрити →</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="note">
        Документацію на решту моделей надішлемо на запит — зателефонуйте {SITE.phonePrimaryDisplay}.
      </p>

      <Disclaimer />
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
  }
  .doc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 760px;
  }
  .doc {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: var(--panel-2);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .doc:hover {
    border-color: var(--led);
    background: var(--panel-3);
  }
  .doc-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }
  .doc b {
    font-family: var(--d);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--paper);
  }
  .also {
    font-size: 0.86rem;
    color: var(--body-soft);
  }
  .desig {
    font-family: var(--m);
    font-size: 0.68rem;
    color: var(--steel-2);
  }
  .pdf {
    font-family: var(--m);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--amber);
    border: 1px solid rgba(240, 169, 59, 0.45);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    flex: none;
  }
  .open {
    flex: none;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--led);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .doc {
      flex-wrap: wrap;
    }
    .doc-text {
      flex-basis: 100%;
    }
  }
  .note {
    margin-top: 1.2rem;
    font-size: 0.84rem;
    color: var(--body-soft);
    max-width: 60ch;
  }
  section :global(.warn) {
    margin-top: clamp(2rem, 5vw, 3rem);
    margin-inline: 0;
  }
</style>
