---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Diagram from '../components/Diagram.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Instrument from '../components/Instrument.astro';
import JsonLd from '../components/JsonLd.astro';
import VideoFacade from '../components/VideoFacade.astro';
import Base from '../layouts/Base.astro';
import { articleSchema, breadcrumbSchema } from '../lib/schema';
import { SITE, url } from '../lib/site';

const title = 'Як працює біомеханічна стимуляція мʼязів | BMS Pro';
const description =
  'Біомеханічна стимуляція — механічний вплив вібраціями 20–40 Гц вздовж мʼязових волокон. Принцип дії, сфери застосування та кому підходить.';
const path = '/how-it-works/';

const trail = [
  { name: 'Головна', href: '/' },
  { name: 'Як це працює', href: path },
];
const abs = (p: string) => new URL(url(p), Astro.site).href;

const EFFECTS = [
  {
    kind: 'circulation' as const,
    title: 'Посилення кровообігу',
    text: 'Вібрація діє як «периферичне серце», стимулюючи рух крові та лімфи в опрацьованій зоні.',
  },
  {
    kind: 'metabolic' as const,
    title: 'Метаболічна активація',
    text: 'Механічні хвилі прискорюють обмін речовин у тканинах і виведення продуктів розпаду.',
  },
  {
    kind: 'neuromuscular' as const,
    title: 'Нейромʼязовий відгук',
    text: 'Стимуляція покращує звʼязок «мозок — мʼяз», що сприяє координації та тонусу.',
  },
];

const USES = [
  {
    title: 'Косметологія',
    text: 'Підтримка тонусу шкіри та мʼязів обличчя, процедури догляду й омолодження.',
  },
  {
    title: 'Спорт та фітнес',
    text: 'Розминка й відновлення мʼязів до та після фізичних навантажень.',
  },
  {
    title: 'Реабілітація',
    text: 'Підтримка мʼязового тонусу за умов малорухливого способу життя.',
  },
];

const WHO = [
  'людям із сидячою або статичною роботою',
  'користувачам із регулярними фізичними навантаженнями',
  'тим, хто шукає простий спосіб механічної стимуляції мʼязів удома',
  'людям старшого віку — за умови дотримання інструкції з експлуатації',
  'для загального мʼязового комфорту',
  'як елемент щоденного догляду за тілом',
];
---

<Base title={title} description={description} canonicalPath={path}>
  <Fragment slot="head">
    <JsonLd data={articleSchema({ title, description }, abs(path))} />
    <JsonLd data={breadcrumbSchema(trail.map((c) => ({ name: c.name, url: abs(c.href) })))} />
  </Fragment>

  <div class="wrap"><Breadcrumbs trail={trail} /></div>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Метод</p>
        <h1>Як працює біомеханічна стимуляція</h1>
        <p>
          Біомеханічна стимуляція — це метод механічного впливу на мʼязи за допомогою вібрацій
          певної частоти та амплітуди, спрямованих уздовж мʼязових волокон. На відміну від
          звичайного масажу, прилад імітує природну роботу мʼяза під час фізичного навантаження,
          що дозволяє активувати глибокі процеси без виснажливих тренувань.
        </p>
      </div>

      <div class="lead-grid">
        <div class="prose">
          <p>
            Метод розробив професор Володимир Назаров у кінці 1970-х — на початку 1980-х років,
            спочатку для підготовки спортивних гімнастів. Вібраційний сигнал передається до
            механорецепторів, і саме напрямок коливань уздовж волокна відрізняє біомеханічну
            стимуляцію від будь-якого масажера з фіксованою частотою.
          </p>
          <p>
            Робочий діапазон приладів BMS — <b>20–40 Гц</b>. Частота задається регулятором на
            панелі: обертанням ручки потенціометра або цифровим індикатором, залежно від моделі.
          </p>
          <p>Такий принцип дозволяє:</p>
          <ul>
            <li>виконувати локальний вплив на окремі групи мʼязів;</li>
            <li>сприяти розслабленню перенапружених ділянок;</li>
            <li>підтримувати мʼязовий тонус у повсякденному використанні.</li>
          </ul>
        </div>
        <Instrument heading="Спробуйте регулятор" />
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Принцип дії</p>
        <h2>Три основні ефекти</h2>
      </div>
      <div class="grid-3">
        {
          EFFECTS.map((e) => (
            <div class="tile">
              <Diagram kind={e.kind} />
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))
        }
      </div>
      <VideoFacade
        id="VV3J9_Tyth4"
        caption="Відео: біомеханічна стимуляція мʼязів — принцип роботи приладу. Тимчасове відео для макета, буде замінено на власне."
      />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Сфери застосування</p>
        <h2>Де використовують прилади BMS</h2>
      </div>
      <div class="grid-3">
        {
          USES.map((u) => (
            <div class="use">
              <h3>{u.title}</h3>
              <p>{u.text}</p>
            </div>
          ))
        }
      </div>

      <div class="who">
        <h2>Кому може бути корисним</h2>
        <ul>
          {WHO.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap">
      <p class="eyebrow eyebrow-center">Замовлення</p>
      <h2>Підберемо прилад під ваше завдання</h2>
      <div class="cta-row cta-center">
        <a class="btn btn-1" href={`tel:${SITE.phonePrimary}`}>☎ {SITE.phonePrimaryDisplay}</a>
        <a class="btn btn-2" href={url('/products/')}>Переглянути прилади</a>
      </div>
      <Disclaimer />
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
  }
  .alt {
    background: #0b1114;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lead-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 940px) {
    .lead-grid {
      grid-template-columns: 1fr;
    }
  }
  .prose {
    max-width: 62ch;
    color: var(--body-soft);
  }
  .prose p {
    margin: 0 0 0.9rem;
  }
  .prose b {
    color: var(--led);
    font-family: var(--m);
  }
  .prose ul {
    list-style: none;
    padding: 0;
    margin-top: 0.6rem;
  }
  .prose li {
    padding-left: 1.1rem;
    position: relative;
    margin: 0.4rem 0;
  }
  .prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--led);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 820px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    padding: 1.3rem 1.4rem 1.5rem;
  }
  .tile h3,
  .use h3 {
    font-size: 1.14rem;
  }
  .tile p,
  .use p {
    font-size: 0.88rem;
    color: var(--body-mute);
    margin-top: 0.45rem;
  }
  .use {
    border-top: 2px solid var(--led);
    padding-top: 1.1rem;
  }

  .who {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    max-width: 70ch;
  }
  .who ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.6rem;
    margin-top: 1.2rem;
  }
  @media (max-width: 700px) {
    .who ul {
      grid-template-columns: 1fr;
    }
  }
  .who li {
    padding-left: 1.6rem;
    position: relative;
    color: var(--body-soft);
    font-size: 0.92rem;
  }
  .who li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--led);
    font-family: var(--m);
  }

  .final {
    text-align: center;
  }
  .final h2 {
    margin: 0.9rem auto 0;
    max-width: 24ch;
  }
  .final :global(.warn) {
    margin-top: clamp(2rem, 5vw, 3rem);
  }
</style>
