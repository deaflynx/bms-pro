---
import { FREQ_MAX, FREQ_MIN, type Indicator, instrumentFor } from '../lib/instrument';

interface Props {
  indicator?: Indicator;
  heading?: string;
}
const { indicator = 'digital', heading = 'Регулятор частоти' } = Astro.props;

const config = instrumentFor(indicator);
const channels = Array.from({ length: config.channels }, (_, i) => i);
---

<div class="instrument" data-digital={String(config.digital)}>
  <div class="inst-head">
    <p class="eyebrow">{heading}</p>
    <span class="inst-tag">{config.label}</span>
  </div>

  {
    channels.map((i) => (
      <div class="channel" data-channel={i}>
        {config.channels > 1 && <p class="ch-label">Канал {i + 1}</p>}

        <div class="scope">
          <svg viewBox="0 0 800 200" preserveAspectRatio="none" aria-hidden="true">
            <line class="mid" x1="0" y1="100" x2="800" y2="100" />
            <path class="trace" data-trace={i} />
          </svg>
        </div>

        {config.digital && (
          <div class="readout">
            <div class="digits" data-digits={i} role="img" aria-label="Поточна частота" />
            <span class="unit">Гц</span>
          </div>
        )}

        <div class="dial">
          <input
            type="range"
            data-freq={i}
            min={FREQ_MIN}
            max={FREQ_MAX}
            step="0.5"
            value={28 + i * 6}
            aria-label={
              config.channels > 1
                ? `Частота коливань, канал ${i + 1}, Гц`
                : 'Частота коливань, Гц'
            }
          />
          <div class="dial-scale">
            <span>{FREQ_MIN} Гц</span><span>30</span><span>{FREQ_MAX} Гц</span>
          </div>
        </div>
      </div>
    ))
  }

  <p class="hint">Потягніть регулятор — робочий діапазон приладів BMS</p>
</div>

<style>
  .instrument {
    background: linear-gradient(168deg, var(--panel-3), var(--panel-2) 62%, #111a1f);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: clamp(1.1rem, 3vw, 1.8rem);
    box-shadow:
      0 30px 70px -34px #000,
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .inst-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .inst-head .eyebrow {
    font-size: 0.62rem;
  }
  .inst-tag {
    font-family: var(--m);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel-2);
    text-align: right;
  }

  .channel + .channel {
    margin-top: 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .ch-label {
    font-family: var(--m);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--led);
    margin-bottom: 0.6rem;
  }

  .scope {
    position: relative;
    height: clamp(76px, 16vw, 118px);
    border-radius: 8px;
    overflow: hidden;
    background: #080d10;
    border: 1px solid rgba(88, 182, 255, 0.16);
  }
  .scope svg {
    position: absolute;
    inset: 0;
    width: 200%;
    height: 100%;
    animation: scroll-trace 1.6s linear infinite;
  }
  .scope :global(.trace) {
    fill: none;
    stroke: var(--led);
    stroke-width: 2.2;
    stroke-linecap: round;
    filter: drop-shadow(0 0 7px rgba(88, 182, 255, 0.85));
  }
  .scope :global(.mid) {
    stroke: rgba(88, 182, 255, 0.2);
    stroke-width: 1;
    stroke-dasharray: 5 7;
  }
  @keyframes scroll-trace {
    to {
      transform: translateX(-50%);
    }
  }

  .readout {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    margin: 1.05rem 0 0.2rem;
  }
  .digits {
    display: flex;
    gap: 0.28rem;
    align-items: flex-end;
  }
  .digits :global(svg) {
    height: clamp(44px, 9vw, 62px);
    width: auto;
    overflow: visible;
  }
  .digits :global(.seg) {
    fill: var(--led-dim);
  }
  .digits :global(.seg.on) {
    fill: var(--led);
    filter: drop-shadow(0 0 6px rgba(88, 182, 255, 0.9));
  }
  .digits :global(.dp) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--led);
    align-self: flex-end;
    margin-bottom: 5px;
    box-shadow: 0 0 7px rgba(88, 182, 255, 0.9);
  }
  .unit {
    font-family: var(--m);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--steel);
    letter-spacing: 0.1em;
    padding-bottom: 0.35rem;
  }

  .dial {
    margin-top: 0.9rem;
  }
  .dial input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 34px;
    background: transparent;
    cursor: grab;
  }
  .dial input::-webkit-slider-runnable-track {
    height: 5px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--led), var(--amber));
  }
  .dial input::-moz-range-track {
    height: 5px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--led), var(--amber));
  }
  .dial input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 26px;
    height: 26px;
    margin-top: -11px;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #f8fafb, #9aa6ac 62%, #4a555a);
    border: 2px solid #0c1216;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
  }
  .dial input::-moz-range-thumb {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid #0c1216;
    background: radial-gradient(circle at 34% 30%, #f8fafb, #9aa6ac 62%, #4a555a);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.6);
  }
  .dial-scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--m);
    font-size: 0.7rem;
    color: var(--steel-2);
    letter-spacing: 0.08em;
  }
  .hint {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--steel);
  }
</style>

<script>
  // 7-segment geometry, mirroring the blue LED indicator on BMS pro and Nexus.
  const SEGS = [
    [12, 2, 36, 11],
    [49, 13, 11, 34],
    [49, 57, 11, 34],
    [12, 91, 36, 11],
    [0, 57, 11, 34],
    [0, 13, 11, 34],
    [12, 46.5, 36, 11],
  ];
  const MAP: Record<number, string> = {
    0: 'abcdef',
    1: 'bc',
    2: 'abdeg',
    3: 'abcdg',
    4: 'bcfg',
    5: 'acdfg',
    6: 'acdefg',
    7: 'abc',
    8: 'abcdefg',
    9: 'abcdfg',
  };
  const KEYS = 'abcdefg';

  function digitSVG(n: number): string {
    const on = MAP[n];
    const rects = SEGS.map(
      (s, i) =>
        `<rect class="seg${on.includes(KEYS[i]) ? ' on' : ''}" x="${s[0]}" y="${s[1]}" width="${s[2]}" height="${s[3]}" rx="3"/>`,
    ).join('');
    return `<svg viewBox="-2 -2 64 108" aria-hidden="true">${rects}</svg>`;
  }

  // Query within each .instrument so two panels on one page never collide.
  document.querySelectorAll<HTMLElement>('.instrument').forEach((root) => {
    root.querySelectorAll<HTMLInputElement>('input[data-freq]').forEach((input) => {
      const i = input.dataset.freq;
      const digits = root.querySelector<HTMLElement>(`[data-digits="${i}"]`);
      const trace = root.querySelector<SVGPathElement>(`[data-trace="${i}"]`);

      const render = (hz: number): void => {
        if (digits) {
          const s = hz.toFixed(1);
          digits.innerHTML = [...s]
            .map((ch) => (ch === '.' ? '<i class="dp"></i>' : digitSVG(Number(ch))))
            .join('');
          digits.setAttribute('aria-label', `${s} герц`);
        }
        if (trace) {
          // 0..800 spans two viewport widths so the scroll animation loops seamlessly.
          const cycles = Math.round((hz - 20) / 2) + 3;
          let d = '';
          for (let x = 0; x <= 800; x += 4) {
            const y = 100 - 68 * Math.sin((x / 400) * cycles * 2 * Math.PI);
            d += (x ? 'L' : 'M') + x + ' ' + y.toFixed(1);
          }
          trace.setAttribute('d', d);
        }
      };

      input.addEventListener('input', (e) =>
        render(Number((e.target as HTMLInputElement).value)),
      );
      render(Number(input.value));
    });
  });
</script>
