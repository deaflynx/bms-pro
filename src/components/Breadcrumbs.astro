---
import { url } from '../lib/site';

export interface Crumb {
  name: string;
  href: string;
}
interface Props {
  trail: Crumb[];
}
const { trail } = Astro.props;
const last = trail.length - 1;
---

<nav class="crumbs" aria-label="Навігаційний ланцюжок">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {i === last ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={url(c.href)}>{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    padding-top: 1.6rem;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    font-family: var(--m);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel-2);
  }
  li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--rule);
  }
  a:hover {
    color: var(--led);
  }
  [aria-current='page'] {
    color: var(--steel);
  }
</style>
