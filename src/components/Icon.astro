---
/** Line pictograms in the same drawing language as Diagram.astro: 24×24 grid,
    round caps, currentColor stroke. */
export type IconKind =
  | 'face'
  | 'sport'
  | 'rehab'
  | 'desk'
  | 'load'
  | 'home'
  | 'senior'
  | 'wave'
  | 'daily';

interface Props {
  kind: IconKind;
}
const { kind } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    kind === 'face' && (
      <>
        <circle cx="10" cy="12.5" r="6.5" />
        <path d="M7.2 14.4c1.5 1.6 4.1 1.6 5.6 0" />
        <path class="dot" d="M8 10.6h.01M12 10.6h.01" />
        <path class="spark" d="M18.6 3.6l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8zM21.4 10.2l.5 1.2 1.2.5-1.2.5-.5 1.2-.5-1.2-1.2-.5 1.2-.5z" />
      </>
    )
  }
  {
    kind === 'sport' && (
      <>
        <circle cx="15" cy="4.6" r="2.1" />
        <path d="M13.6 8.2l-2.2 4.6 3.4 1.9 1 5.6" />
        <path d="M13.9 9.4l-4.4 1.7M14.8 12.7l3.9 1.4" />
        <path d="M11.4 12.8l-4 3.1" />
      </>
    )
  }
  {
    kind === 'rehab' && (
      <>
        <path d="M20.2 12a8.2 8.2 0 1 1-2.6-6" />
        <path d="M17.4 2.6v3.6h-3.6" />
        <path d="M12 8.6v6.8M8.6 12h6.8" />
      </>
    )
  }
  {
    kind === 'desk' && (
      <>
        <path d="M4 15.5v-3.2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3.2" />
        <path d="M2.8 15.5h18.4" />
        <path d="M5.6 15.5V19M18.4 15.5V19" />
        <path d="M7.5 10.3V7.8a1.8 1.8 0 0 1 1.8-1.8h5.4a1.8 1.8 0 0 1 1.8 1.8v2.5" />
      </>
    )
  }
  {
    kind === 'load' && (
      <>
        <path d="M3 9.8v4.4M6.2 7.6v8.8M17.8 7.6v8.8M21 9.8v4.4" />
        <path d="M6.2 12h11.6" />
      </>
    )
  }
  {
    kind === 'home' && (
      <>
        <path d="M3.6 11L12 4.4l8.4 6.6v8a1 1 0 0 1-1 1H4.6a1 1 0 0 1-1-1z" />
        <path d="M9.6 20v-5.4h4.8V20" />
      </>
    )
  }
  {
    kind === 'senior' && (
      <>
        <circle cx="9.6" cy="4.8" r="2.1" />
        <path d="M9.6 7.4v6.8" />
        <path d="M9.6 14.2l-2.2 5.6M9.6 14.2l2.4 5.6" />
        <path d="M9.6 9.4l4.6 1.8" />
        <path d="M16.4 10.4V20" />
      </>
    )
  }
  {
    kind === 'wave' && (
      <>
        <path d="M2.4 12c2-5 4-5 6 0s4 5 6 0 4-5 6 0" />
        <path class="faint" d="M2.4 17c2-3.2 4-3.2 6 0s4 3.2 6 0 4-3.2 6 0" />
        <path class="faint" d="M2.4 7c2-3.2 4-3.2 6 0s4 3.2 6 0 4-3.2 6 0" />
      </>
    )
  }
  {
    kind === 'daily' && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <path d="M12 6.8V12l3.4 2.2" />
      </>
    )
  }
</svg>

<style>
  .icon {
    width: var(--icon-size, 30px);
    height: var(--icon-size, 30px);
    flex: none;
    color: var(--led);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon :global(.faint) {
    stroke: rgba(255, 255, 255, 0.22);
  }
  .icon :global(.dot) {
    stroke-width: 2;
  }
  .icon :global(.spark) {
    fill: currentColor;
    stroke: none;
  }
</style>
