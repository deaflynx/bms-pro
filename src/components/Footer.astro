---
import { NAV, SITE, url } from '../lib/site';

const year = 2026;
---

<footer>
  <div class="wrap foot-grid">
    <div>
      <p class="legal">© {year} {SITE.name} · {SITE.legalName}</p>
      <p class="decl">Декларація {SITE.declaration} · {SITE.declarationDateDisplay}</p>
    </div>
    <nav aria-label="Розділи сайту">
      <ul>
        {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        <li><a href={url('/privacy-policy/')}>Політика конфіденційності</a></li>
      </ul>
    </nav>
    <address>
      {SITE.address.postalCode}, {SITE.address.city}, {SITE.address.street}<br />
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
      <a href={`tel:${SITE.phonePrimary}`}>{SITE.phonePrimaryDisplay}</a> ·
      <a href={`tel:${SITE.phoneSecondary}`}>{SITE.phoneSecondaryDisplay}</a>
    </address>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 2.4rem 0;
    font-size: 0.82rem;
    color: var(--steel-2);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.6rem clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 820px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
  .legal {
    color: var(--steel);
  }
  .decl {
    font-family: var(--m);
    font-size: 0.72rem;
    margin-top: 0.35rem;
  }
  nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  nav a:hover {
    color: var(--led);
  }
  address {
    font-style: normal;
    line-height: 1.9;
  }
  address a:hover {
    color: var(--led);
  }
</style>
